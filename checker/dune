; Careful with bug https://github.com/ocaml/odoc/issues/148
;
; If we don't pack checker we will have a problem here due to
; duplicate module names in the whole build.
(library
 (name coq_checklib)
 (public_name rocq-runtime.checklib)
 (synopsis "Rocq's Standalone Proof Checker")
 (modules :standard \ rocqchk coqchk votour library_label)
 (wrapped true)
 (libraries rocq-runtime.boot rocq-runtime.kernel))

(deprecated_library_name
 (old_public_name coq-core.checklib)
 (new_public_name rocq-runtime.checklib))

(executable
 (name rocqchk)
 (public_name rocqchk)
 (modes exe byte)
 (package rocq-runtime)
 (modules rocqchk)
 (flags :standard -open Coq_checklib)
 (libraries coq_checklib))

(executable
 (name coqchk)
 (public_name coqchk)
 (modes exe byte)
 (package coq-core)
 (modules coqchk)
 (flags :standard -open Coq_checklib)
 (libraries coq_checklib))

(executable
 (name votour)
 (public_name votour)
 (package rocq-runtime)
 (modules votour)
 (flags :standard -open Coq_checklib)
 (libraries coq_checklib))

; rocq-library-label: the location-free library label of a .vo file
; (vernac/libkeyObjects.ml), recomputed from its content, its
; attempted-resolution records, and how this build represents what a .vo
; stores. A reader of compiled libraries, as votour is, and the oracle of
; test-suite/misc/library-label*.sh and misc/vo-format.sh. It links
; rocqworker's toplevel and every plugin statically, so that the object
; kinds registered here are the ones a compile registers once it has
; loaded its plugins, and the checker's value schema for
; --vo-representation.
(executable
 (name library_label)
 (public_name rocq-library-label)
 (package rocq-runtime)
 (modules library_label)
 (link_flags -linkall)
 (libraries
  rocq-runtime.vernac
  rocq-runtime.toplevel
  rocq-runtime.checklib
  rocq-runtime.plugins.ltac
  rocq-runtime.plugins.tauto
  rocq-runtime.plugins.ltac2
  rocq-runtime.plugins.ltac2_ltac1
  rocq-runtime.plugins.ssrmatching
  rocq-runtime.plugins.ssreflect
  rocq-runtime.plugins.btauto
  rocq-runtime.plugins.cc
  rocq-runtime.plugins.derive
  rocq-runtime.plugins.extraction
  rocq-runtime.plugins.firstorder
  rocq-runtime.plugins.funind
  rocq-runtime.plugins.micromega
  rocq-runtime.plugins.zify
  rocq-runtime.plugins.nsatz
  rocq-runtime.plugins.ring
  rocq-runtime.plugins.rtauto
  rocq-runtime.plugins.number_string_notation))

